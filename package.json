{
  "name": "svg-to-gcode-converter",
  "version": "0.1.0",
  "description": "Convert SVG files to GCode with grayscale-to-depth mapping for GRBL controllers",
  "main": "src/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "jest",
    "lint": "eslint src/**/*.js",
    "build": "webpack --mode production",
    "package": "electron-builder --dir",
    "package-win": "electron-builder --win",
    "package-mac": "electron-builder --mac",
    "package-linux": "electron-builder --linux",
    "package-all": "electron-builder -mwl",
    "release": "electron-builder -mwl -p always"
  },
  "build": {
    "appId": "com.svgtogcode.app",
    "productName": "SVG to GCode Converter",
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Graphics"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "keywords": [
    "svg",
    "gcode",
    "cnc",
    "converter",
    "grbl",
    "grayscale"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bezier-js": "^6.1.4",
    "color-convert": "^2.0.1",
    "electron": "^26.1.0",
    "electron-log": "^5.3.4",
    "jsdom": "^22.1.0",
    "svg-parser": "^2.0.4",
    "svgpath": "^2.6.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "electron-builder": "^24.6.4",
    "electron-updater": "^6.1.4",
    "eslint": "^8.48.0",
    "jest": "^29.6.4",
    "nodemon": "^3.0.1",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  }
}
